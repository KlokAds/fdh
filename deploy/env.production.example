APP_NAME="Friends Dream Home"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Admin panel URL prefix — something hard to guess
FDH_ADMIN_PATH=fdh-admin
FDH_LOGIN_MAX_ATTEMPTS=5
FDH_LOGIN_DECAY_SECONDS=900
FDH_LOGIN_IP_MAX_ATTEMPTS=20
FDH_ADMIN_IDLE_MINUTES=30
FDH_INQUIRY_PER_HOUR=5

# Browser push notifications (filled in by the installer)
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
FDH_META_GRAPH_VERSION=v23.0

# Website updates from GitHub (Admin → System update)
FDH_UPDATE_REPO=KlokAds/fdh
FDH_UPDATE_BRANCH=release
FDH_UPDATE_TOKEN=
